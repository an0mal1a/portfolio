# Browser-facing endpoints (contact form, public GitHub sync jobs).
NUXT_PUBLIC_API_BASE=http://localhost:4040
NUXT_PUBLIC_PYTHON_API_BASE=http://localhost:4041

# Cloudflare Turnstile, contact form. Public key of the widget; empty turns it off.
# This is Cloudflare's test key (always passes); pair it with the test secret in backends/.env.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-side (Nitro) base for Rust API reads. Empty = use NUXT_PUBLIC_API_BASE.
# docker-compose.override.yml sets it to http://rust-api:8000 inside the container.
NUXT_API_INTERNAL_BASE=
