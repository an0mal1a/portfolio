INSERT INTO portfolio.projects (
    github_repository_github_id,
    client_id,
    name,
    slug,
    tagline,
    description,
    project_type,
    status,
    repository_url,
    live_url,
    is_featured,
    is_public,
    started_at,
    completed_at
)
SELECT
    1000000001,
    NULL,
    'Proyecto Mock 1',
    'mock-project-1',
    'Mock tagline 1',
    'Descripción mock para el proyecto 1.',
    'web',
    'published',
    NULL,
    'https://example.com/project-1',
    TRUE,
    TRUE,
    '2026-01-10',
    NULL
WHERE NOT EXISTS (
    SELECT 1 FROM portfolio.projects WHERE slug = 'mock-project-1'
);

INSERT INTO portfolio.projects (
    github_repository_github_id,
    client_id,
    name,
    slug,
    tagline,
    description,
    project_type,
    status,
    repository_url,
    live_url,
    is_featured,
    is_public,
    started_at,
    completed_at
)
SELECT
    1000000002,
    (SELECT id FROM portfolio.clients WHERE name = 'Test 1' AND website = 'https://example.com'),
    'Proyecto Mock 2',
    'mock-project-2',
    'Mock tagline 2',
    'Descripción mock para el proyecto 2.',
    'web',
    'in_progress',
    NULL,
    'https://example.com/project-2',
    FALSE,
    TRUE,
    '2026-02-15',
    NULL
WHERE NOT EXISTS (
    SELECT 1 FROM portfolio.projects WHERE slug = 'mock-project-2'
);

