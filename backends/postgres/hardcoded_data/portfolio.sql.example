INSERT INTO portfolio.clients (
    name,
    website,
    logo_url
)
SELECT 'Test 1', 'https://example.com', 'https://logo_url.com'
WHERE NOT EXISTS (
    SELECT 1 FROM portfolio.clients WHERE name = 'Test 1' AND website = 'https://example.com'
);

